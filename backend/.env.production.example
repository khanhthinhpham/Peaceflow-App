NODE_ENV=production
API_PREFIX=/api/v1

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://your-frontend.vercel.app,https://peaceflow.vn,https://www.peaceflow.vn

# Managed PostgreSQL connection string for production
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require

# Generate new secrets for production; do not reuse local development secrets
JWT_ACCESS_SECRET=<generate-a-new-64-char-secret>
JWT_REFRESH_SECRET=<generate-a-new-64-char-secret>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
