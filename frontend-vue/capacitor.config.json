{
  "appId": "vn.peaceflow.app",
  "appName": "PeaceFlow",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 700,
      "backgroundColor": "#FFF8F0",
