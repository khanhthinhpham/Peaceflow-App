NODE_ENV=production
API_PREFIX=/api/v1

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://your-frontend.vercel.app,https://peaceflow.vn,https://www.peaceflow.vn

# Managed PostgreSQL connection string for production
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require

# Generate new secrets for production; do not reuse local development secrets
JWT_ACCESS_SECRET=<generate-a-new-64-char-secret>
JWT_REFRESH_SECRET=<generate-a-new-64-char-secret>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Zoom Server-to-Server OAuth. Tài khoản host phải thuộc cùng Zoom account.
ZOOM_ACCOUNT_ID=<zoom-account-id>
ZOOM_CLIENT_ID=<zoom-client-id>
ZOOM_CLIENT_SECRET=<zoom-client-secret>
ZOOM_HOST_USER_ID=<zoom-host-user-id-or-email>
ZOOM_WEBHOOK_SECRET_TOKEN=<zoom-secret-token>
